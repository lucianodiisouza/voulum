{
  "sourceLanguage": "en",
  "strings": {
    "%@ Hz: %@ dB. Double-click to reset.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hz: %@ dB. Clique duas vezes para zerar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hz: %@ dB. Haz doble clic para restablecer."
          }
        }
      }
    },
    "%lld percent": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld por cento"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld por ciento"
          }
        }
      }
    },
    "A Dock with workspaces and live widgets": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Dock com ambientes e widgets ao vivo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dock con espacios y widgets en vivo"
          }
        }
      }
    },
    "A native Mac cleaner with a one-time price": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpador de Mac nativo, com pagamento único"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpiador de Mac nativo, con pago único"
          }
        }
      }
    },
    "A teleprompter in your Mac's notch": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleprompter no notch do Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleprompter en el notch del Mac"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de"
          }
        }
      }
    },
    "Acoustic": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acústico"
          }
        },
        "es": {
