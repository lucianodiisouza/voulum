    "Apps appear here when they play sound.\nPin one from its ⋯ menu to keep it here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps aparecem aqui quando tocam algum som.\nFixe um pelo menu ⋯ para mantê-lo aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps aparecen aquí cuando reproducen sonido.\nFija una desde su menú ⋯ para que se quede aquí."
          }
        }
      }
    },
