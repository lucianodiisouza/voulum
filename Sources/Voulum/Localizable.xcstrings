    "The first time you change an app, macOS asks to let Voulum handle its audio. Choose Allow.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez que você mudar um app, o macOS vai pedir para o Voulum cuidar do áudio dele. Escolha Permitir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez que cambies una app, macOS pedirá que Voulum gestione su audio. Elige Permitir."
          }
        }
      }
    },
    "The short intro from the first launch.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação rápida da primeira vez que você abriu o app."
