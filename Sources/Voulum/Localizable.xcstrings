    "Voulum needs permission to adjust app audio.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Voulum precisa de permissão para ajustar o áudio dos apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum necesita permiso para ajustar el audio de las apps."
          }
        }
      }
    },
    "Voulum sets an app's volume by playing its sound back at the level you choose. macOS asks once. Nothing is recorded, and nothing leaves your Mac.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Voulum ajusta o volume de um app tocando o som dele de volta no nível que você escolher. O macOS pergunta uma vez. Nada é gravado e nada sai do seu Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum ajusta el volumen de una app reproduciendo su sonido al nivel que elijas. macOS lo pregunta una vez. No se graba nada y nada sale de tu Mac."
          }
        }
      }
    },
    "Voulum won't list ignored apps or touch their audio.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Voulum não lista apps ignorados nem mexe no áudio deles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum no muestra las apps ignoradas ni toca su audio."
          }
        }
      }
