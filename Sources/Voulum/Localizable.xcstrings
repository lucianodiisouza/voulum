    "Adaptive": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptável"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptable"
          }
        }
      }
    },
    "Adaptive shows the kind of device you're listening on. Every style turns into a slashed speaker when the output is muted.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptável mostra o tipo de aparelho em que você está ouvindo. Todos os estilos viram um alto-falante cortado quando a saída está muda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptable muestra el tipo de dispositivo en el que escuchas. Todos los estilos se convierten en un altavoz tachado cuando la salida está silenciada."
          }
        }
      }
    },
    "Allow Audio Access": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso ao áudio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso al audio"
          }
        }
      }
    },
    "Allow Voulum to control this app in System Settings ▸ Privacy & Security ▸ Automation.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Voulum controle este app em Ajustes do Sistema ▸ Privacidade e Segurança ▸ Automação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Voulum controle esta app en Ajustes del Sistema ▸ Privacidad y seguridad ▸ Automatización."
          }
        }
      }
    },
    "Allow microphone access to see its level": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone para ver o nível"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono para ver su nivel"
          }
        }
