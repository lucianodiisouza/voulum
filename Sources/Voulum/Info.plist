<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Voulum</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu-bar only: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Shown when macOS prompts for audio-capture permission (needed to tap
	     another process's audio for volume control). -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Voulum picks up app audio so it can set each app's volume.</string>
	<!-- Shown when macOS prompts to allow controlling a media app (Spotify,
	     Apple Music, VLC), used to read the current track and drive playback. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Voulum asks media apps and browsers what's playing so it can show the title and play or pause them.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voulum picks up app audio so it can set each app's volume.</string>
	<!-- Sparkle auto-update. SUPublicEDKey must be filled in before updates
	     will verify (see docs/UPDATES.md). Interval is 24h. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/lucianodiisouza/voulum/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_YOUR_SPARKLE_PUBLIC_ED_KEY</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- voulum:// automation links (see URLCommands.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.voulum.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voulum</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
</dict>
</plist>
