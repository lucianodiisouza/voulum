{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum picks up app audio so it can set each app's volume."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Voulum capta o áudio dos apps para ajustar o volume de cada um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum capta el audio de las apps para ajustar el volumen de cada una."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulum picks up app audio so it can set each app's volume."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Voulum capta o áudio dos apps para ajustar o volume de cada um."
          }
        },
        "es": {
